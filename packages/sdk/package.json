{
  "name": "@recordem/sdk",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "description": "TypeScript client of the Recordem API: meetings, recordings, transcripts, notes, search, webhooks",
  "keywords": ["recordem", "meetings", "transcription", "meeting-notes", "openapi"],
  "homepage": "https://github.com/recordem/recordem/tree/main/packages/sdk",
  "repository": { "type": "git", "url": "git+https://github.com/recordem/recordem.git", "directory": "packages/sdk" },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist", "LICENSE", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "generate": "bun --filter @recordem/contract openapi && openapi-typescript ../contract/openapi.json -o src/schema.d.ts && bun scripts/client.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "bun scripts/pack.ts prepack",
    "postpack": "bun scripts/pack.ts postpack"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
