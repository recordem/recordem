# auth (identity provider)
AUTH_PORT=39410
AUTH_URL=http://localhost:39410
AUTH_DATABASE_URL=postgres://recordem_auth:recordem_auth@localhost:39420/recordem
BETTER_AUTH_SECRET=change-me-to-32-random-bytes
# the api's door into auth (upload tokens): a port only the cluster reaches, and a secret both share
AUTH_INTERNAL_PORT=39413
AUTH_INTERNAL_URL=http://localhost:39413
INTERNAL_SECRET=change-me-to-32-random-bytes

# api (resource server)
API_PORT=39411
API_URL=http://localhost:39411
DATABASE_URL=postgres://recordem:recordem@localhost:39420/recordem
REDIS_URL=redis://localhost:39421
API_SECRET=change-me-to-32-random-bytes

# audio storage: a folder on disk by default; set S3_BUCKET for any S3-compatible store (R2, AWS, Garage…)
# STORAGE_DIR=./data/storage
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# worker (webhook delivery). Webhooks never go to private addresses; development may allow it (smoke test).
# WEBHOOK_ALLOW_PRIVATE=1
# worker (meeting notes): any OpenAI-compatible chat API. Without a key, no notes are written.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-v4-pro
# LLM_API_KEY=

# web portal (browser origins allowed by api and auth)
WEB_PORT=39412
WEB_ORIGINS=http://localhost:39412
